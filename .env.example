# ---- Aegis config ----
# Copy this file to .env and fill in your own values. .env is gitignored.

# Which chain to talk to: "arc" (default, the hackathon target) or "sepolia".
CHAIN="arc"

# RPC endpoint. Optional on Arc - leave it blank and the client auto-rotates
# across the public gateways (rpc / drpc / blockdaemon / quicknode
# .testnet.arc.network), falling over when one rate-limits. Set it only to pin
# a single dedicated endpoint.
#   Sepolia (CHAIN=sepolia): https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=""

# Private key of your THROWAWAY test wallet (0x-prefixed, 64 hex chars).
# Use a dedicated test wallet, never a personal one, even on testnet.
# On Arc there is no separate gas token - fund this wallet with testnet USDC
# from https://faucet.circle.com and that same USDC pays for gas AND payments.
#
# This is the AGENT key: the hot one that calls guardedPay and pays its own gas.
# Give it a thin float and nothing more. On Arc the ERC-20 at 0x3600.. is a
# 6-decimal view over the native balance, so it is one pot with two windows:
# guardedPay moves it through the ERC-20 window, and ordinary gas burns it
# through the native window. Gas is taken before the contract's first opcode
# runs, so no on-chain rule can bound it - the only bound is how much this
# wallet holds. Whatever sits here is what a hijacked agent gets to burn.
#
# Keeping the treasury on this same key means 100% of the guarded funds are
# burnable as gas, outside the daily cap. `npm run rotate-keys` splits the three
# roles apart (treasury / owner / agent) against the guard you already deployed,
# no redeploy needed.
PRIVATE_KEY=""

# USDC token contract. Optional on Arc - defaults to the ERC-20 interface at
# 0x3600000000000000000000000000000000000000 (6 decimals). On Sepolia set it to
# Circle's test USDC: 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
USDC_ADDRESS=""

# Recipient A: a good, normal EOA (any second address you control or know).
GOOD_RECIPIENT=""

# Recipient B: the malicious contract (filled after deploy-bad-contract.js runs).
BAD_RECIPIENT=""

# AegisGuard contract address (filled after deploy-guard.js runs).
# This is the on-chain firewall the agent routes payments through.
AEGIS_GUARD=""

# The treasury wallet, for `npm run rotate-keys`. ADDRESS ONLY - the treasury's
# private key is never needed here, because the guard moves funds with
# transferFrom against an allowance. That key signs exactly one thing in its
# life: approve(AEGIS_GUARD, ...) on USDC. Keep it somewhere this repo can't
# reach, which is the entire point of splitting it off the agent.
# NEW_AGENT / NEW_OWNER are optional and default to the current wallet.
NEW_TREASURY=""

# TEMPORARY, and only for `npm run treasury-approve`. The treasury signs exactly
# one transaction in its life - approve(AEGIS_GUARD, ...) - so put the key here,
# run that command once, then DELETE this line. config.js never reads it, which
# is deliberate: nothing in the normal run path can touch the treasury key.
TREASURY_PRIVATE_KEY=""

# The agent's x402 signing wallet: a SECOND throwaway wallet, distinct from
# PRIVATE_KEY above (using the same key would let x402 signatures draw on the
# whole treasury, which defeats the float design). It signs EIP-3009 payment
# authorizations and holds only a small float - the treasury refills it through
# the guard (ensureFloat), so the daily limit caps x402 spend too.
# Set the key to run the x402 demo (the address is derived from it); or set just
# the address if this process only tops the wallet up and never signs.
# Leave both blank if you're not running the x402 demo.
X402_PRIVATE_KEY=""
X402_WALLET=""
