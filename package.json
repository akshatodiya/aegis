{
  "name": "aegis",
  "version": "1.0.0",
  "description": "A firewall for AI agents paying USDC on Arc. Screens the recipient before a guarded transfer or an x402 payment is signed, and answers PAY, BLOCK or ASK_HUMAN.",
  "type": "module",
  "scripts": {
    "balance": "node scripts/check-balance.js",
    "deploy-bad": "node scripts/deploy-bad-contract.js",
    "deploy-guard": "node scripts/deploy-guard.js",
    "deploy-audit-log": "node scripts/deploy-audit-log.js",
    "audit-log": "node scripts/audit-log.js",
    "guard-setup": "node scripts/guard-setup.js",
    "treasury-approve": "node scripts/treasury-approve.js",
    "rotate-keys": "node scripts/rotate-keys.js",
    "one-pot": "node scripts/one-pot.js",
    "clone-family": "node scripts/clone-family.js",
    "verify-guard": "node scripts/verify-guard.js",
    "good": "node src/agent.js good",
    "bad": "node src/agent.js bad",
    "approve-good": "node src/agent.js approve good",
    "approve-bad": "node src/agent.js approve bad",
    "guard-good": "node src/agent.js guard good",
    "guard-bad": "node src/agent.js guard bad",
    "test": "node --test test/*.test.mjs",
    "x402-demo": "node src/x402-demo.js",
    "sell-demo": "node src/aegis-service-demo.js",
    "drain": "node scripts/injected-drain.js",
    "kill-switch": "node scripts/kill-switch.js"
  },
  "keywords": [
    "arc",
    "usdc",
    "ai-agent",
    "security",
    "evm",
    "bytecode"
  ],
  "author": "Akshat Odiya",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "viem": "^2.54.6"
  },
  "devDependencies": {
    "solc": "0.8.28"
  }
}
